{
  "provider": "deepseek",
  "base_url": "https://api.deepseek.com",
  "model": "deepseek-flash",
  "api_key_env": "DEEPSEEK_API_KEY",
  "timeout": 180,
  "retries": 3,
  "max_tokens": 8192,
  "token_field": "max_tokens",
  "json_mode": true,
  "request_options": {
    "thinking": {
      "type": "disabled"
    }
  }
}
